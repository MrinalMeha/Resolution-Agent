# Pick ONE provider and paste a FREE key (no credit card needed).
LLM_PROVIDER=groq

# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# or Groq key: https://console.groq.com/keys   (set LLM_PROVIDER=groq)
GROQ_API_KEY=

# Optional: override model(s), comma-separated = fallback order (free tiers can 429 / retire models)
# LLM_MODEL=llama3-8b-8192
